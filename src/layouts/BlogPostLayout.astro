---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyMobileCTA from '../components/StickyMobileCTA.astro';

const { frontmatter } = Astro.props;
const { title, description, pubDate, heroImage, category, author, topProduct } = frontmatter;
---
<!DOCTYPE html>
<html lang="en" class="scroll-smooth bg-slate-950 text-slate-100 antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO title={title} description={description} heroImage={heroImage} pubDate={pubDate} authorName={author?.name} category={category} type="article" />
  </head>
  <body class="min-h-screen flex flex-col font-sans">
    <Header />
    <main class="flex-grow max-w-5xl mx-auto px-4 py-12 w-full">
      <div class="reveal mb-6 rounded-xl border border-amber-500/20 bg-amber-500/5 p-4 text-xs text-slate-300">
        <span class="font-bold text-amber-400 uppercase">Affiliate Disclosure:</span> We earn commissions from curated links at no extra cost to you.
      </div>
      <h1 class="reveal reveal-delay-1 text-3xl sm:text-5xl font-black text-slate-100">{title}</h1>
      <p class="reveal reveal-delay-2 mt-4 text-lg text-slate-300">{description}</p>
      <div class="reveal reveal-delay-3 my-8 rounded-2xl overflow-hidden border border-slate-800">
        <img src={heroImage} alt={title} class="motion-image w-full max-h-[450px] object-cover" />
      </div>
      <div class="reveal reveal-delay-3 prose prose-invert prose-amber max-w-none">
        <slot />
      </div>
    </main>
    {topProduct && <StickyMobileCTA title={topProduct.name} rating={topProduct.rating} buttonText={topProduct.buttonText} affiliateUrl={topProduct.affiliateUrl} />}
    <Footer />
    <!-- Cloudflare Web Analytics --><script type='module' src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "387fc8d372cb447c9a1be39fb5c56148"}'></script><!-- End Cloudflare Web Analytics -->
  </body>
</html>